# Copy to `.env` and fill in a vision-capable model.
# Any OpenAI-compatible endpoint works: OpenAI, Ollama, vLLM, LiteLLM, etc.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=your-vision-model

# Optional tuning
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=4
# auto | function_calling | json_schema | json
LLM_STRUCTURED_OUTPUT=auto

MAX_FILES=50
MAX_FILE_MB=15
ANALYSIS_TTL_MINUTES=60

# Optional: keep uploads in a fixed directory instead of a temporary one.
# UPLOAD_DIR=./data/uploads
