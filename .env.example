# Copy to `.env` and set your OpenRouter API key.
# Get a key at https://openrouter.ai/keys
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-your-openrouter-key
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# Any OpenAI-compatible endpoint works too. For example Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=your-vision-model

# Optional tuning
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 同時に投げる判定リクエスト数（大きくすると速いが、レート制限に注意）
LLM_CONCURRENCY=8

MAX_FILES=500
MAX_FILE_MB=15
ANALYSIS_TTL_MINUTES=60

# Optional: keep uploads in a fixed directory instead of a temporary one.
# UPLOAD_DIR=./data/uploads
